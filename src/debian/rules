#!/usr/bin/make -f

export DESTROOT=$(CURDIR)/debian/seedsync

%:
	dh $@ --with=systemd

override_dh_auto_build:
	dh_auto_build

override_dh_auto_install:
	dh_auto_install
	mkdir -p $(DESTROOT)/usr/lib
	cp -rf seedsync $(DESTROOT)/usr/lib/

override_dh_shlibdeps:
	# PyInstaller bundles the executable dependencies, so shared-library
	# resolution against the host build image is not meaningful here.
